# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings → API). NUNCA versione o arquivo ".env".

# URL do projeto — ex: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "service_role" — tem acesso total, ignora RLS. Usar SÓ no backend.
SUPABASE_SERVICE_ROLE_KEY=coloque_aqui_a_service_role_key

# Porta do servidor Express (apenas as rotas do professor)
PORT=3000

# --------------------------------------------------------------
# Upload de vídeo-aulas para o YouTube (OPCIONAL)
# --------------------------------------------------------------
# 1. Crie um projeto em https://console.cloud.google.com, ative a
#    "YouTube Data API v3" e crie uma credencial OAuth 2.0 do tipo
#    "Aplicativo para computador" (Desktop app).
# 2. Preencha os dois valores abaixo com o Client ID e Client Secret
#    dessa credencial.
# 3. Rode `npm run autorizar-youtube` UMA VEZ (com o canal do projeto
#    logado no navegador que abrir) para gerar o YOUTUBE_REFRESH_TOKEN.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=
